# Provider priority (left to right). Supported values: azure-openai, openai, github-models
REACT_APP_MODEL_PROVIDER_PRIORITY=azure-openai,openai,github-models

# -------------------------
# Azure OpenAI (preferred)
# -------------------------
# Example: https://your-resource-name.openai.azure.com
REACT_APP_AZURE_OPENAI_ENDPOINT=
REACT_APP_AZURE_OPENAI_API_KEY=
# Deployment name in Azure OpenAI Studio
REACT_APP_AZURE_OPENAI_DEPLOYMENT=
# Optional; default in app is 2024-06-01
REACT_APP_AZURE_OPENAI_API_VERSION=2024-06-01

# -------------------------
# OpenAI
# -------------------------
REACT_APP_OPENAI_API_KEY=
# Optional; defaults to https://api.openai.com/v1
REACT_APP_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional; defaults to gpt-4o-mini
REACT_APP_OPENAI_MODEL=gpt-4o-mini

# -------------------------
# GitHub Models
# -------------------------
REACT_APP_GITHUB_TOKEN=
# Optional; defaults to gpt-4o
REACT_APP_GITHUB_MODEL=gpt-4o
# Optional; defaults to https://models.inference.ai.azure.com/chat/completions
REACT_APP_GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com/chat/completions
